# ==========================================
# Shopify Configuration
# ==========================================
# Format: your-store-name.myshopify.com
SHOPIFY_SHOP_DOMAIN=
# Latest stable Admin GraphQL API version
SHOPIFY_ADMIN_API_VERSION=2026-10

# Option 1: Direct Admin Access Token (shpat_...)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option 2: Dev Dashboard Client ID + Secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ==========================================
# LLM & Embedding Providers
# ==========================================
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==========================================
# Vector DB & Storage (RAG)
# ==========================================
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ==========================================
# FastAPI Backend Configuration
# ==========================================
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True
